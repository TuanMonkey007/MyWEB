// Schema theo mục 3 của BA-quan-ly-tai-chinh.md
// SQLite không hỗ trợ enum/Decimal trong Prisma nên:
// - Wallet.type nhận: CASH | BANK | EWALLET | INVEST (validate ở tầng app)
// - Category.kind nhận: EXPENSE | INCOME
// - Tiền VNĐ lưu Float nhưng luôn là số nguyên (BR-7); USD/tỷ giá có thập phân

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wallet {
  id             String   @id @default(cuid())
  name           String
  type           String
  initialBalance Float    @default(0)
  balanceUSD     Float?
  exchangeRate   Float?
  adjustment     Float    @default(0)
  notes          String?
  url            String?
  createdAt      DateTime @default(now())

  expenses      Expense[]
  incomes       Income[]
  transfersFrom Transfer[] @relation("TransferFrom")
  transfersTo   Transfer[] @relation("TransferTo")
}

model Category {
  id   String @id @default(cuid())
  name String
  kind String

  expenses Expense[]
  incomes  Income[]

  @@unique([name, kind])
}

model Expense {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  occurredAt DateTime
  imagePath  String?
  createdAt  DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([walletId])
}

model Income {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  occurredAt DateTime
  imagePath  String?
  createdAt  DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([walletId])
}

model Transfer {
  id         String   @id @default(cuid())
  title      String?
  amount     Float
  occurredAt DateTime
  imagePath  String?
  createdAt  DateTime @default(now())

  fromWalletId String
  fromWallet   Wallet @relation("TransferFrom", fields: [fromWalletId], references: [id], onDelete: Cascade)
  toWalletId   String
  toWallet     Wallet @relation("TransferTo", fields: [toWalletId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
}

// ===== Module Đề xuất mua hàng =====
// Số đã chi/còn lại của quỹ KHÔNG lưu — tính động trong lib/procurement.ts:
// còn lại = Σ(phân bổ 12 tháng) − Σ(actualAmount các hạng mục PURCHASED)

model BudgetYear {
  id        String   @id @default(cuid())
  year      Int      @unique
  title     String?
  notes     String?
  createdAt DateTime @default(now())

  groups    BudgetGroup[]
  proposals Proposal[]
}

model BudgetGroup {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  code         String // "01".."09"
  name         String
  sortOrder    Int        @default(0)

  funds BudgetFund[]

  @@unique([budgetYearId, code])
}

// Quỹ = dòng khoản mục chi tiết trong BM02B, phân bổ theo 12 tháng (VNĐ)
model BudgetFund {
  id        String      @id @default(cuid())
  groupId   String
  group     BudgetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  m1        Float       @default(0)
  m2        Float       @default(0)
  m3        Float       @default(0)
  m4        Float       @default(0)
  m5        Float       @default(0)
  m6        Float       @default(0)
  m7        Float       @default(0)
  m8        Float       @default(0)
  m9        Float       @default(0)
  m10       Float       @default(0)
  m11       Float       @default(0)
  m12       Float       @default(0)
  notes     String?
  sortOrder Int         @default(0)

  items ProposalItem[]
}

// Đợt đề xuất mua hàng (phiếu CT.MH-QT-01/BM01)
model Proposal {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  number       Int // STT đợt trong năm
  title        String?
  proposedAt   DateTime
  notes        String?
  createdAt    DateTime   @default(now())

  items       ProposalItem[]
  attachments Attachment[]

  @@unique([budgetYearId, number])
}

model ProposalItem {
  id             String     @id @default(cuid())
  proposalId     String
  proposal       Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fundId         String
  fund           BudgetFund @relation(fields: [fundId], references: [id])
  name           String
  unit           String? // ĐVT
  quantity       Float      @default(1)
  specs          String? // yêu cầu kỹ thuật
  reason         String? // lý do đề xuất
  status         String     @default("PENDING") // PENDING | PURCHASED | CANCELLED
  proposedAmount Float      @default(0)
  actualAmount   Float? // tiền mua thực tế (VAT), chỉ khi PURCHASED
  purchasedAt    DateTime?
  notes          String?
  createdAt      DateTime   @default(now())

  attachments Attachment[]

  @@index([fundId])
  @@index([status])
}

// Cài đặt chung của platform (giao diện, mẫu xuất phiếu...) — key/value
model AppSetting {
  key   String @id
  value String
}

// ===== Tài khoản & phân quyền =====
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String?
  passwordHash String // scrypt$N$salt$hash
  role         String   @default("USER") // ADMIN | USER
  modules      String   @default("") // (cũ) CSV id module — giữ để tương thích ngược
  permissions  String   @default("") // JSON { moduleId: [capId,...] } phân quyền chi tiết
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions     Session[]
  vaultConfig  VaultConfig?
  vaultEntries VaultEntry[]
  articles     Article[]
}

// ===== Module Kho mật khẩu (vault mã hóa đầu-cuối, riêng từng user) =====
// Server CHỈ lưu bản mã: mật khẩu chủ và khóa giải mã không bao giờ rời trình
// duyệt. salt + verifier để client tự kiểm tra mật khẩu chủ đúng khi mở khóa.
model VaultConfig {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  salt     String // base64, dùng cho PBKDF2
  verifier String // base64 SHA-256 của nửa verifier trong khóa dẫn xuất
  kdfIters Int    @default(600000)
}

model VaultEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  username  String   @default("")
  url       String   @default("")
  category  String   @default("")
  cipher    String // base64(iv||ct) AES-256-GCM của JSON {password, notes}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Phiên đăng nhập lưu DB — thu hồi được ngay (xóa user/đổi mật khẩu là hết phiên)
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===== Module Drive (kho file) =====
// Tối ưu lưu trữ: file vật lý lưu content-addressed theo SHA-256 (chống trùng
// lặp — 2 file trùng nội dung chỉ tốn 1 lần đĩa). StoredFile là "tên hiển thị"
// trỏ tới nội dung qua sha256; xóa file vật lý chỉ khi không còn ai trỏ tới.
model Folder {
  id        String   @id @default(cuid())
  name      String
  isPublic  Boolean  @default(false)
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  files     StoredFile[]
  createdAt DateTime @default(now())

  @@index([parentId])
}

model StoredFile {
  id        String   @id @default(cuid())
  name      String
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  size      Int // byte (tối đa ~2GB/file)
  mimeType  String
  sha256    String // địa chỉ nội dung → file vật lý drive/<sha[0:2]>/<sha>
  createdAt DateTime @default(now())

  @@index([folderId])
  @@index([sha256])
}

// ===== Module Todolist =====
model Todo {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String    @default("TODO") // TODO | DOING | DONE
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

// ===== Thời gian biểu / Lịch trình công việc & học tập =====
model TimetableItem {
  id          String   @id @default(cuid())
  date        String?  // Ngày cụ thể "YYYY-MM-DD" (vd: "2026-10-03")
  dayOfWeek   Int      // 1 = Thứ 2, 2 = Thứ 3, ..., 6 = Thứ 7, 7 = Chủ Nhật
  subject     String   // Môn học / Nhiệm vụ / Công việc
  session     String   @default("MORNING") // MORNING | AFTERNOON | EVENING
  startTime   String?  // "08:00"
  endTime     String?  // "11:30"
  location    String?  // Phòng học, văn phòng, địa điểm, online
  note        String?  // Ghi chú chi tiết
  color       String   @default("orange") // orange | emerald | blue | purple | amber | rose
  isRecurring Boolean  @default(false) // True: lặp lại hàng tuần theo dayOfWeek | False: lịch riêng của ngày date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([dayOfWeek])
}

// File bằng chứng: cấp phiếu (bản ký) hoặc cấp hạng mục (hóa đơn, ảnh lỗi...)
model Attachment {
  id        String   @id @default(cuid())
  fileName  String // tên file gốc
  filePath  String // {uuid}.{ext} trong UPLOAD_DIR/files
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  proposalId String?
  proposal   Proposal?     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  itemId     String?
  item       ProposalItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ===== Bài hướng dẫn (kiểu diễn đàn) =====
model ArticleCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  articles    Article[]
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String? // mô tả ngắn hiện ở danh sách
  content   String // nội dung bài — xem cột format
  // HTML: soạn bằng trình trực quan (mặc định) | MARKDOWN: bài cũ, vẫn đọc được
  format    String   @default("HTML")
  coverImage String? // tên file ảnh bìa trong UPLOAD_DIR/articles
  // DRAFT: chỉ tác giả + admin thấy | INTERNAL: cần đăng nhập | PUBLIC: ai cũng đọc
  visibility String  @default("DRAFT")
  pinned    Boolean  @default(false) // ghim lên đầu chuyên mục
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?

  categoryId String?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId   String
  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([visibility, publishedAt])
  @@index([categoryId])
}
