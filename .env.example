# Đường dẫn file SQLite (tương đối so với thư mục prisma/)
# Production Windows Server có thể dùng đường dẫn tuyệt đối, vd: file:D:/appdata/finance.db
DATABASE_URL="file:./dev.db"

# Thư mục lưu ảnh hóa đơn — nên đặt NGOÀI thư mục code khi production
# vd Windows: D:/appdata/uploads
UPLOAD_DIR="./uploads"

# Mật khẩu KHỞI TẠO cho tài khoản quản trị đầu tiên (username: admin).
# Chỉ dùng khi hệ thống chưa có user nào (cài mới / reset) — sau đó mọi
# tài khoản + mật khẩu quản lý trong app (trang Cài đặt), đổi ở /account.
APP_PASSWORD="doimatkhau123"

# Khóa mã hóa các bí mật lưu trong DB (API key mail...). Để trống thì hệ thống
# tự sinh file .app-secret cạnh file database. Đặt giá trị ngẫu nhiên dài nếu
# muốn tự quản lý — ĐỔI giá trị này sẽ khiến các key đã lưu phải nhập lại.
APP_SECRET=""

# ─────────────────────────── GỬI MAIL ───────────────────────────
# KHUYẾN NGHỊ: cấu hình mail ngay trên giao diện /mailtest (thẻ "Cấu hình mail",
# chỉ quản trị viên) — lưu vào database, key được mã hóa, có hiệu lực ngay.
# Các biến dưới đây chỉ là DỰ PHÒNG khi database chưa có cấu hình nào.
# Giá trị: log | resend | brevo | mailgun | smtp
#   log     — mặc định, chỉ in ra console, KHÔNG gửi thật (dev / chưa đăng ký)
#   resend  — HTTP API, cổng 443
#   brevo   — HTTP API, cổng 443
#   mailgun — HTTP API, cổng 443
#   smtp    — dùng được cho mọi nhà + mail server nội bộ (cần: npm i nodemailer)
MAIL_DRIVER="log"

# Địa chỉ gửi — phải thuộc tên miền ĐÃ xác minh SPF/DKIM ở nhà cung cấp
MAIL_FROM="MyWEB <no-reply@tuandeptrai.io.vn>"
# Địa chỉ nhận thư trả lời (tùy chọn)
MAIL_REPLY_TO=""

# --- Chỉ cần điền phần của nhà đang dùng ---
RESEND_API_KEY=""

BREVO_API_KEY=""

MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_REGION="us"          # us | eu — sai vùng sẽ báo lỗi 401

SMTP_HOST=""
SMTP_PORT="587"              # 587 (STARTTLS) hoặc 465 (SSL)
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=""               # để trống = tự suy theo cổng
