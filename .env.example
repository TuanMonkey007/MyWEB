# Đường dẫn file SQLite (tương đối so với thư mục prisma/)
# Production Windows Server có thể dùng đường dẫn tuyệt đối, vd: file:D:/appdata/finance.db
DATABASE_URL="file:./dev.db"

# Thư mục lưu ảnh hóa đơn — nên đặt NGOÀI thư mục code khi production
# vd Windows: D:/appdata/uploads
UPLOAD_DIR="./uploads"

# Mật khẩu KHỞI TẠO cho tài khoản quản trị đầu tiên (username: admin).
# Chỉ dùng khi hệ thống chưa có user nào (cài mới / reset) — sau đó mọi
# tài khoản + mật khẩu quản lý trong app (trang Cài đặt), đổi ở /account.
APP_PASSWORD="doimatkhau123"
