# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database & uploads (backup riêng, không commit)
/prisma/*.db
/prisma/*.db-journal
/uploads

# cấu hình cục bộ Claude Code
.claude/settings.local.json
.claude/.claude-backup

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
